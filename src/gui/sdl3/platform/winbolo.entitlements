<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Steam overlay + client integration: under hardened runtime, the Steam
         client injects gameoverlayrenderer.dylib via DYLD_INSERT_LIBRARIES.
         allow-dyld-environment-variables lets dyld honor that injection;
         disable-library-validation lets the Valve-signed dylib load despite
         being signed by a different Team ID. Without both, the overlay AND
         rich presence are dead on signed/notarized builds. -->
    <!-- LuaJIT (bot brains) compiles Lua to machine code at runtime. It is
         built with LUAJIT_ENABLE_OSX_HRT so mcode areas are mmap'd with
         MAP_JIT; allow-jit is the entitlement that lets the hardened
         runtime execute those pages. Without it the process is killed at
         startup with SIGKILL (Code Signature Invalid) on the first
         compiled trace. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
