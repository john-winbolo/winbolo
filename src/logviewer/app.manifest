<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly manifestVersion="1.0"
          xmlns="urn:schemas-microsoft-com:asm.v1"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
	<asmv3:assemblyIdentity version="1.0.0.1" name="WinBolo.LogViewer"/>
	<!-- DO NOT specify <asmv3:requestedExecutionLevel>; this will cause WritePrivateProfileString to fail,
	     breaking WinBolo.INI access via file virtualization. -->
	<asmv3:application>
		<!-- The UI is GPU-rendered (SDL_Renderer + ImGui), so GDI scaling does not
		     apply to it; declaring the process per-monitor DPI aware lets SDL create a
		     true physical-resolution window and the UI scales itself from the window size. -->
		<asmv3:windowsSettings>
			<dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
		</asmv3:windowsSettings>
	</asmv3:application>
</assembly>