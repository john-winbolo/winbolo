"In Game Actions"
{
    "actions"
    {
        "InGame"
        {
            "title"    "#in_game"
            "legacy_set" "0"

            "StickPadGyro"
            {
                "tank_move"
                {
                    "title"       "#act_tank_move"
                    "input_mode"  "joystick_move"
                }
                "map_scroll"
                {
                    "title"       "#act_map_scroll"
                    "input_mode"  "joystick_camera"
                }
            }

            "AnalogTrigger"
            {
                "fire"   "trigger_right"
                "mine"   "trigger_left"
            }

            "Button"
            {
                "fire"           "#act_fire"
                "mine"           "#act_mine"
                "build_confirm"  "#act_build_confirm"
                "view_cycle"     "#act_view_cycle"
                "gunsight_dec"   "#act_gunsight_dec"
                "gunsight_inc"   "#act_gunsight_inc"
                "build_prev"     "#act_build_prev"
                "build_next"     "#act_build_next"
                "quick_chat"     "#act_quick_chat"
                "pause"          "#act_pause"
                "status_toggle"  "#act_status_toggle"
            }
        }

        "Menu"
        {
            "title"    "#menu"
            "legacy_set" "0"

            "Button"
            {
                "menu_accept"     "#act_menu_accept"
                "menu_cancel"     "#act_menu_cancel"
                "menu_nav_up"     "#act_menu_nav_up"
                "menu_nav_down"   "#act_menu_nav_down"
                "menu_nav_left"   "#act_menu_nav_left"
                "menu_nav_right"  "#act_menu_nav_right"
            }
        }

        "Build"
        {
            "title"    "#build"
            "legacy_set" "0"

            "Button" { }
        }
    }

    "localization"
    {
        "english"
        {
            "in_game"           "In Game"
            "menu"              "Menus"
            "build"             "Build (reserved)"

            "act_tank_move"     "Drive Tank"
            "act_map_scroll"    "Scroll Map"
            "act_fire"          "Fire"
            "act_mine"          "Lay Mine"
            "act_build_confirm" "Send LGM (build at gunsight)"
            "act_view_cycle"    "Cycle View"
            "act_gunsight_dec"  "Gunsight Range -1"
            "act_gunsight_inc"  "Gunsight Range +1"
            "act_build_prev"    "Previous Build Type"
            "act_build_next"    "Next Build Type"
            "act_quick_chat"    "Quick Chat"
            "act_pause"         "Pause Menu"
            "act_status_toggle" "Toggle Status Overlay"

            "act_menu_accept"   "Accept"
            "act_menu_cancel"   "Back / Cancel"
            "act_menu_nav_up"   "Navigate Up"
            "act_menu_nav_down" "Navigate Down"
