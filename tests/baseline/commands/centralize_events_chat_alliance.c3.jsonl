# centralize_events_chat_alliance_3client_udp — client 3 (slot 2).
# Asks c1 for an alliance as soon as it is in (c1 is connected
# before c3 starts), then sends a unicast chat back to slot 0 (c1).
# c1 accepts at its tick 250, after this tick-30 request has reached
# it through the server, so the server-side alliance state mutates
# before the chat sends fire.
{"tick": 30, "op": "alliance_request", "from": 2, "to": 0}
{"tick": 400, "op": "chat", "dest": 0, "body": "hi ally c1 from c3"}
