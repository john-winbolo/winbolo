<?xml version="1.0" encoding="utf-8"?>
<!-- The directories the FileProvider in AndroidManifest.xml serves to the
     share sheet: the app's files directory (SDL's pref path, where the round
     recorder writes recordings, the recap's clip export writes its GIF, and
     a recording another app handed over is copied under incoming/) and the
     cache directory. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="files" path="."/>
    <cache-path name="cache" path="."/>
</paths>
